# demo: local preview, no real money. api: authenticated backend.
VITE_PAYMENT_MODE=api
# Use the HTTPS address printed by dotnet run; trust the development certificate.
API_PROXY_TARGET=https://localhost:7207

# Firebase public web configuration (same project as backend; never put service-account keys here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
