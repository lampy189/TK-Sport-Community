# Copy to runtime.env (ignored by Git). Supply real values on the deployment host.
# Docker --env-file reads these lines. Native dotnet does NOT load this file automatically.
ASPNETCORE_ENVIRONMENT=Production
Chatbot__ApiKey=
Chatbot__Model=gpt-5-mini
Chatbot__MessengerUrl=
Chatbot__ZaloUrl=
# Explicit public policy allowlist. Use only real codes approved for Player publication.
# Chatbot__PublicPolicyCodes__0=PLAYER_BOOKING_GUIDE
# Chatbot__PublicPolicyCodes__1=PLAYER_REFUND_POLICY
ConnectionStrings__Sep490=Server=YOUR_SQL_HOST;Database=Sep490;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
# Existing payment/email integrations require their own production settings; see be_da/README.md.
# Use a unique positive namespace per database sharing a payOS channel. Keep it stable once links exist.
# Payments__PayOS__OrderCodeNamespace=0
# Keep optional email delivery disabled until configured.
Email__Enabled=false
# IP of the actual trusted reverse proxy as seen by the backend (set for your network).
# ReverseProxy__KnownProxies__0=172.17.0.1

# Zalo OA: enabled for this deployment. Fill secrets before restarting the backend.
# Missing required values cause startup validation to fail; use false to deploy without Zalo.
Zalo__Enabled=true
Zalo__WorkerEnabled=true
Zalo__AppId=4264224527443928540
Zalo__OaId=4045665017807398845
Zalo__OaSecretKey=
Zalo__AppSecret=
Zalo__AccessToken=
# Optional automatic renewal: requires AppSecret, private persistent TokenFile and persistent
# ASP.NET Data Protection keys. See deploy/README-zalo.md before enabling refresh.
Zalo__RefreshToken=
Zalo__TokenFile=
# Optional: restrict bookings to one venue ID. Omit to allow all active venues.
# Zalo__VenueId=1
