# Copy to runtime.env (ignored by Git). Supply real values on the deployment host.
# Docker --env-file reads these lines. Native dotnet does NOT load this file automatically.
ASPNETCORE_ENVIRONMENT=Production
Chatbot__ApiKey=
Chatbot__Model=gpt-5-mini
# Explicit public policy allowlist. Use only real codes approved for Player publication.
# Chatbot__PublicPolicyCodes__0=PLAYER_BOOKING_GUIDE
# Chatbot__PublicPolicyCodes__1=PLAYER_REFUND_POLICY
ConnectionStrings__Sep490=Server=YOUR_SQL_HOST;Database=Sep490;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
# Existing payment/email integrations require their own production settings; see be_da/README.md.
# Keep optional email delivery disabled until configured.
Email__Enabled=false
# IP of the actual trusted reverse proxy as seen by the backend (set for your network).
# ReverseProxy__KnownProxies__0=172.17.0.1
