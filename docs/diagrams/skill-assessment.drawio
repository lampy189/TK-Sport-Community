  </diagram><diagram id="X3TBSQ_2UEYhClpfe6qq" name="02-sequence-skill-assessment-publish">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;sequenceDiagram\nautonumber\nactor Ref as Referee\nparticipant UI as Referee Web App\nparticipant API as AssessmentsController\nparticipant SVC as SkillAssessmentService\nparticipant SC as SportAssessmentScoring\nparticipant DB as SQL Server\n\nRef-&gt;&gt;UI: Open assessment for attendee\nUI-&gt;&gt;API: POST open (sessionId, playerId)\nAPI-&gt;&gt;SVC: OpenAsync\nSVC-&gt;&gt;DB: Check referee assigned to session (session_referees)\nSVC-&gt;&gt;DB: Check ticket paid and checked-in, not self-assessment\nSVC-&gt;&gt;DB: Load active Rubric + RubricDimensions of the sport\nSVC-&gt;&gt;DB: INSERT Assessment (draft) + AssessmentScore per dimension\nSVC--&gt;&gt;UI: AssessmentView (rubric, marks, revision)\n\nloop each criterion (score / detailed sliders, optional comment)\n  Ref-&gt;&gt;UI: Enter mark\n  UI-&gt;&gt;API: PUT save (revision, marks)\n  API-&gt;&gt;SVC: SaveAsync\n  SVC-&gt;&gt;DB: Check status = draft and revision unchanged\n  SVC-&gt;&gt;SC: CriterionPoints / CalculatePoints / Band\n  SVC-&gt;&gt;DB: UPDATE AssessmentScore, TotalScore, BandResult + audit\n  SVC--&gt;&gt;UI: AssessmentView\nend\n\nRef-&gt;&gt;UI: Publish result\nUI-&gt;&gt;API: POST publish (revision, expectedProfileScore, expectedProfileBand)\nAPI-&gt;&gt;SVC: PublishAsync\nSVC-&gt;&gt;DB: Verify profile unchanged and no newer observation\nalt Profile already rated (periodic review)\n  SVC-&gt;&gt;SC: ReviewScore(total, previous total)\n  Note over SVC: If confirmed band would change: return 409 and STOP; Manager review required\nend\nSVC-&gt;&gt;SC: Band(total)\nSVC-&gt;&gt;DB: INSERT PlayerRatingHistory (old/new score and band)\nSVC-&gt;&gt;DB: UPDATE PlayerSportProfile (CurrentScore, CurrentBand, Rated)\nSVC-&gt;&gt;DB: UPDATE Assessment status = published\n\nSVC-&gt;&gt;DB: SaveChanges (single transaction)\nSVC--&gt;&gt;UI: Published AssessmentView\n\n&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="Swzb5RhU51CTAeLpF314-10">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Referee" mermaidId="n:Ref" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Referee" id="Swzb5RhU51CTAeLpF314-11">
          <mxCell parent="Swzb5RhU51CTAeLpF314-10" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
            <mxGeometry height="1549.0" width="150" x="30" y="30" as="geometry" />
