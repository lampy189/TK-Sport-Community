    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Sport {\n  +long Id\n  +string Code\n  +string Name\n}\nclass Rubric {\n  &lt;&lt;SportSkillScheme&gt;&gt;\n  +long Id\n  +long SportId\n  +string Version\n  +string Name\n  +bool IsActive\n}\nclass RubricDimension {\n  +long Id\n  +long RubricId\n  +string Code\n  +string Name\n  +short WeightPercent\n}\nclass PlayerSportProfile {\n  +long Id\n  +long PlayerId\n  +long SportId\n  +short CurrentScore\n  +string CurrentBand\n  +string RatingStatus\n}\nclass Assessment {\n  +long Id\n  +long PlayerSportProfileId\n  +long SessionId\n  +long RubricId\n  +long AssessorId\n  +string AssessmentType\n  +string Status\n  +short TotalScore\n  +string BandResult\n}\nclass AssessmentScore {\n  +long Id\n  +long AssessmentId\n  +long DimensionId\n  +short Score\n}\nclass PlayerRatingHistory {\n  +long Id\n  +long PlayerSportProfileId\n  +short OldScore\n  +short NewScore\n  +string OldBand\n  +string NewBand\n  +long ChangedBy\n  +long AssessmentId\n}\nclass RatingAppeal {\n  +long Id\n  +long AssessmentId\n  +long PlayerSportProfileId\n}\nclass Session {\n  +long Id\n  +long SportId\n  +string Band\n  +short Capacity\n  +int PriceVnd\n  +string Status\n}\nclass SportAssessmentScoring {\n  &lt;&lt;static domain rules&gt;&gt;\n  +CriterionPoints(score, sliderScores) short\n  +CalculatePoints(points) short\n  +Band(total) string\n  +ReviewScore(current, prior) short\n  +Supports(rubric) bool\n}\nclass SkillAssessmentService {\n  &lt;&lt;application service&gt;&gt;\n  +OpenAsync(sessionId, playerId, actorId)\n  +SaveAsync(id, actorId, request)\n  +PublishAsync(id, actorId, request)\n}\n\nSport \&quot;1\&quot; --&gt; \&quot;*\&quot; Rubric : defines\nRubric \&quot;1\&quot; *-- \&quot;*\&quot; RubricDimension : has criteria\nSport \&quot;1\&quot; --&gt; \&quot;*\&quot; PlayerSportProfile : per sport\nPlayerSportProfile \&quot;1\&quot; --&gt; \&quot;*\&quot; Assessment : evaluated by\nRubric \&quot;1\&quot; --&gt; \&quot;*\&quot; Assessment : scored with\nSession \&quot;1\&quot; --&gt; \&quot;*\&quot; Assessment : observed in\nAssessment \&quot;1\&quot; *-- \&quot;*\&quot; AssessmentScore : marks\nRubricDimension \&quot;1\&quot; --&gt; \&quot;*\&quot; AssessmentScore : criterion\nPlayerSportProfile \&quot;1\&quot; --&gt; \&quot;*\&quot; PlayerRatingHistory : rating log\nAssessment \&quot;0..1\&quot; --&gt; \&quot;*\&quot; PlayerRatingHistory : produces\nAssessment \&quot;1\&quot; --&gt; \&quot;*\&quot; RatingAppeal : may be appealed\nSkillAssessmentService ..&gt; SportAssessmentScoring : uses\nSkillAssessmentService ..&gt; Assessment : creates / publishes\n&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="ui5WZpNwamZdJmnPlq91-1">
